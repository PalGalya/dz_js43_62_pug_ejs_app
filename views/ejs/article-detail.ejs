<!DOCTYPE html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <style>
      .dark { background: #1a1a1a; color: #fff; }
      .dark .card { background: #2d2d2d; border-color: #444; }
      .theme-switcher { position: fixed; top: 10px; right: 10px; z-index: 1000; }
      .auth-panel { position: fixed; top: 10px; left: 10px; z-index: 1000; }
    </style>
  </head>
  <body class="<%= theme === 'dark' ? 'dark' : '' %>">
    <div class="auth-panel">
      <% if (user) { %>
        <span>Привіт, <%= user %>!</span>
        <button id="logout" class="btn btn-sm">Вийти</button>
      <% } else { %>
        <button id="login" class="btn btn-sm">Увійти</button>
        <button id="register" class="btn btn-sm">Реєстрація</button>
      <% } %>
    </div>
    <div class="theme-switcher">
      <button id="themeToggle" class="btn btn-sm"><%= theme === 'dark' ? '☀️' : '🌙' %></button>
    </div>
    <div class="container">
      <div class="navigation">
        <p>
          <a href="/articles">← Назад до списку</a>
          <span> | </span>
          <a href="/">На головну</a>
          <span> | </span>
          <a href="/users">Користувачі (PUG)</a>
        </p>
      </div>

      <% if (article) { %>
      <div class="article-details">
        <article class="article-content">
          <header class="article-header">
            <h1><%= article.title %></h1>
            <div class="article-meta">
              <p class="article-author">
                <strong>Автор:</strong> <%= article.author %>
              </p>
              <p class="article-date">
                <strong>Дата публікації:</strong> <%= article.date %>
              </p>
              <p class="article-category">
                <strong>Категорія:</strong> <%= article.category %>
              </p>
              <% if (article.tags && article.tags.length > 0) { %>
              <div class="article-tags">
                <strong>Теги:</strong>
                <% article.tags.forEach(function(tag, index) { %>
                <span class="tag"><%= tag %></span><% if (index <
                article.tags.length - 1) { %>, <% } %> <% }); %>
              </div>
              <% } %>
            </div>
          </header>

          <div class="article-body">
            <% if (article.image) { %>
            <img
              src="<%= article.image %>"
              alt="<%= article.title %>"
              class="article-image"
            />
            <% } %>
            <div class="article-text"><%- article.content %></div>
          </div>
        </div>
      </div>
      <% } else { %>
      <div class="error">
        <h1>Статтю не знайдено</h1>
        <p>Стаття з таким ID не існує.</p>
        <a href="/articles" class="btn btn-primary"
          >Повернутися до списку статей</a
        >
      </div>
      <% } %>

      <footer class="footer">
        <p>
          &copy; 2024 Express PUG+EJS Demo. Домашнє завдання з курсу Full-stack
          JavaScript.
        </p>
      </footer>
    </div>

    <script>
      // Theme toggle
      document.getElementById('themeToggle').onclick = () => {
        const currentTheme = document.body.classList.contains('dark') ? 'light' : 'dark';
        fetch('/auth/theme', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ theme: currentTheme })
        }).then(() => location.reload());
      };

      // Auth handlers
      document.getElementById('logout')?.onclick = () => {
        fetch('/auth/logout', { method: 'POST' }).then(() => location.reload());
      };

      document.getElementById('login')?.onclick = () => {
        const username = prompt('Ім\'я користувача:');
        const password = prompt('Пароль:');
        if (username && password) {
          fetch('/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password })
          }).then(res => res.json()).then(data => {
            alert(data.message);
            if (data.user) location.reload();
          });
        }
      };

      document.getElementById('register')?.onclick = () => {
        const username = prompt('Ім\'я користувача:');
        const password = prompt('Пароль:');
        if (username && password) {
          fetch('/auth/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password })
          }).then(res => res.json()).then(data => {
            alert(data.message);
            if (data.user) location.reload();
          });
        }
      };
    </script>
  </body>
</html>
