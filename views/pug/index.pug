extends layout

block content
  .container
    h1= title
    .welcome-message
      p Ласкаво просимо до демонстрації інтеграції PUG та EJS шаблонізаторів!

    .navigation-menu
      h2 Оберіть розділ:
      .menu-items
        .menu-item
          h3
            a(href='/users') Користувачі
          p Перегляд списку користувачів та їх деталей
          p
            em Використовує: PUG шаблонізатор

        .menu-item
          h3
            a(href='/articles') Статті
          p Перегляд статей та їх повного змісту
          p
            em Використовує: EJS шаблонізатор

    .demo-info
      h2 Про проект
      p Цей проект демонструє:
      ul
        li Інтеграцію PUG та EJS шаблонізаторів в одному Express додатку
        li Відображення списків та деталізованої інформації
        li Різні підходи до створення динамічних веб-сторінок
        li CSS стилізацію для покращення зовнішнього вигляду
