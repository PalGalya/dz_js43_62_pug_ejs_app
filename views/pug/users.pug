extends layout

block content
  .container
    h1= title
    .navigation
      p
        a(href='/') На головну
        span  |
        a(href='/articles') Статті (EJS)

    .users-list
      if users && users.length > 0
        h2 Список користувачів:
        ul.user-items
          each user in users
            li.user-item
              .user-card
                h3.user-name= user.name
                p.user-email Email: #{user.email}
                p.user-age Вік: #{user.age}
                .user-actions
                  a.btn.btn-primary(href=`/users/${user.id}`) Детальніше
      else
        .no-users
          p Користувачів не знайдено.

    .add-user
      a.btn.btn-success(href="/users/new") Додати користувача