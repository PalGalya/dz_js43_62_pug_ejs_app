<!DOCTYPE html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <style>
      .dark {
        background: #1a1a1a;
        color: #fff;
      }
      .dark .card {
        background: #2d2d2d;
        border-color: #444;
      }
      .theme-switcher {
        position: fixed;
        top: 10px;
        right: 10px;
        z-index: 1000;
      }
      .auth-panel {
        position: fixed;
        top: 10px;
        left: 10px;
        z-index: 1000;
      }
    </style>
  </head>
  <body class="<%= theme === 'dark' ? 'dark' : '' %>">
    <div class="auth-panel">
      <% if (user) { %>
      <span>Привіт, <%= user %>!</span>
      <button id="logout" class="btn btn-sm">Вийти</button>
      <% } else { %>
      <button id="login" class="btn btn-sm">Увійти</button>
      <button id="register" class="btn btn-sm">Реєстрація</button>
      <% } %>
    </div>
    <div class="theme-switcher">
      <button id="themeToggle" class="btn btn-sm">
        <%= theme === 'dark' ? '☀️' : '🌙' %>
      </button>
    </div>
    <div class="container">
      <h1><%= title %></h1>
      <div class="navigation">
        <p>
          <a href="/">На головну</a>
          <span> | </span>
          <a href="/users">Користувачі (PUG)</a>
        </p>
      </div>

      <div class="articles-list">
        <% if (articles && articles.length > 0) { %>
        <h2>Список статей:</h2>
        <div class="article-items">
          <% articles.forEach(function(article) { %>
          <div class="article-item">
            <div class="article-card">
              <h3 class="article-title"><%= article.title %></h3>
              <p class="article-excerpt"><%= article.excerpt %></p>
              <div class="article-meta">
                <span class="article-author">Автор: <%= article.author %></span>
                <span class="article-date">Дата: <%= article.date %></span>
                <span class="article-category"
                  >Категорія: <%= article.category %></span
                >
              </div>
              <div class="article-actions">
                <a href="/articles/<%= article.id %>" class="btn btn-primary"
                  >Читати повністю</a
                >
              </div>
            </div>
          </div>
          <% }); %>
        </div>
        <% } else { %>
        <div class="no-articles">
          <p>Статей не знайдено.</p>
        </div>
        <% } %>
      </div>

      <footer class="footer">
        <p>
          &copy; 2024 Express PUG+EJS Demo. Домашнє завдання з курсу Full-stack
          JavaScript.
        </p>
      </footer>
    </div>

    <script>
      // Theme toggle
      document.getElementById('themeToggle').onclick = () => {
        const currentTheme = document.body.classList.contains('dark') ? 'light' : 'dark';
        fetch('/auth/theme', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ theme: currentTheme })
        }).then(() => location.reload());
      };

      // Auth handlers
      document.getElementById('logout')?.onclick = () => {
        fetch('/auth/logout', { method: 'POST' }).then(() => location.reload());
      };

      document.getElementById('login')?.onclick = () => {
        const username = prompt('Ім\'я користувача:');
        const password = prompt('Пароль:');
        if (username && password) {
          fetch('/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password })
          }).then(res => res.json()).then(data => {
            alert(data.message);
            if (data.user) location.reload();
          });
        }
      };

      document.getElementById('register')?.onclick = () => {
        const username = prompt('Ім\'я користувача:');
        const password = prompt('Пароль:');
        if (username && password) {
          fetch('/auth/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password })
          }).then(res => res.json()).then(data => {
            alert(data.message);
            if (data.user) location.reload();
          });
        }
      };
    </script>
  </body>
</html>
