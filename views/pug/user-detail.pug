extends layout

block content
  .container
    .navigation
      p
        a(href='/users') ← Назад до списку
        span  |
        a(href='/') На головну
        span  |
        a(href='/articles') Статті (EJS)

    if user
      .user-details
        h1= title
        .user-info
          .user-avatar
            img(src=user.avatar || '/images/default-avatar.svg' alt=user.name)
          .user-data
            h2.user-name= user.name
            p.user-email
              strong Email:
              span= user.email
            p.user-age
              strong Вік:
              span= user.age
            if user.bio
              p.user-bio
                strong Біографія:
                span= user.bio
            if user.location
              p.user-location
                strong Місцезнаходження:
                span= user.location
    else
      .error
        h1 Користувача не знайдено
        p Користувач з таким ID не існує.
        a.btn.btn-primary(href='/users') Повернутися до списку